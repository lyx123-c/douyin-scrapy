{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:douyin-workbench:update-manifest:1",
  "title": "Douyin Workbench Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "channel",
    "version",
    "tag",
    "commit",
    "build_time",
    "release_sequence",
    "published_at",
    "min_supported_version",
    "minimum_updater_version",
    "release_notes",
    "files",
    "changes",
    "packages",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "channel": {
      "type": "string",
      "enum": [
        "stable"
      ]
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "build_time": {
      "type": "string",
      "format": "date-time"
    },
    "release_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "min_supported_version": {
      "$ref": "#/$defs/semver"
    },
    "minimum_updater_version": {
      "$ref": "#/$defs/semver"
    },
    "release_notes": {
      "type": "string",
      "maxLength": 100000
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "replaced",
        "removed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/programPath"
          },
          "uniqueItems": true
        },
        "replaced": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/programPath"
          },
          "uniqueItems": true
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/programPath"
          },
          "uniqueItems": true
        }
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/packageEntry"
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signatureEntry"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "programPath": {
      "type": "string",
      "pattern": "^(program|updater)/[^\\u0000-\\u001f]+"
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/programPath"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executable": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "packageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "type",
        "base_version",
        "target_version",
        "archive_format",
        "delta_algorithm",
        "url",
        "size",
        "sha256"
      ],
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "type": {
          "enum": [
            "full",
            "file_delta",
            "binary_delta"
          ]
        },
        "base_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_version": {
          "$ref": "#/$defs/semver"
        },
        "archive_format": {
          "enum": [
            "nsis",
            "zip"
          ]
        },
        "delta_algorithm": {
          "enum": [
            "none",
            "hpatch"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "signatureEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "signature"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
